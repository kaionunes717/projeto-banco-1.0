# banco python
saldo = 0
while True:
    opçao = input("Digite 1 para consultar saldo, 2 para sacar, 3 para depositar e 4 para sair: ")
    if opçao == "1":
        print(f"Seu saldo é de R${saldo}")
    elif opçao == "2":
        valor = float(input("Digite o valor que deseja sacar: "))
        if valor > saldo:
            print("Saldo insuficiente.")
        else:
            saldo -= valor
            print(f"Saque realizado com sucesso. Seu saldo atual é de R${saldo}")
    elif opçao == "3":
        valor = float(input("Digite o valor que deseja depositar: "))
        saldo += valor
        print(f"Depósito realizado com sucesso. Seu saldo atual é de R${saldo}")
    elif opçao == "4":
        break
    else:
        print("Opção inválida. Tente novamente.")


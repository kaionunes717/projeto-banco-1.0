import time
from abc import ABC, abstractmethod

idade = 18

usuarios = (("kaio", "1234"), ("lucas", "5678"), ("andre", "2213"))


class destinatario(ABC):
    def __init__(self, nome):
        self.nome = nome

    @abstractmethod
    def verificar_destinatario(self):
        """Valida se o destinatário pode receber a transferência."""
        pass

    @abstractmethod
    def mostrar_detalhes(self):
        """Retorna uma descrição útil do destinatário."""
        pass

    @abstractmethod
    def processar_transferencia(self, valor):
        """Registra a transferência no destinatário."""
        pass


class destinatario_bancario(destinatario):
    def verificar_destinatario(self):
        return bool(self.nome.strip()) and bool(self.conta.strip())

    def mostrar_detalhes(self):
        return f"{self.nome} (Conta: {self.conta})"

    def processar_transferencia(self, valor):
        return f"Transferência enviada para {self.nome} no valor de R${valor:.2f}."


while True:
    usuario = input("Digite seu usuário: ")
    senha = input("Digite sua senha: ")

    login_sucesso = False
    for nome, senha_cadastrada in usuarios:
        print("verificando...")
        time.sleep(2)
        if usuario == nome and senha == senha_cadastrada:
            print("Login bem sucedido!")
            login_sucesso = True
            break

    if login_sucesso:
        break

    if usuario not in [nome for nome, _ in usuarios]:
        print("Usuário incorreto. Tente novamente.")
    elif senha not in [senha_cadastrada for _, senha_cadastrada in usuarios]:
        print("Senha incorreta. Tente novamente.")
    else:
        print("Usuário e senha incorretos. Tente novamente.")

# banco python
saldo = 0

while True:
    opcao = input("Digite 1 para consultar saldo, 2 para sacar, 3 para depositar e 4 para sair, 5 para transferir: ")
    if opcao == "1":
        print(f"Seu saldo é de R${saldo}")
    elif opcao == "2":
        while True:
            valor = float(input("Digite o valor que deseja sacar: "))
            if valor <= 0:
                print("Valor inválido. Tente novamente.")
                continue
            deseja = input("Deseja mesmo sacar esse valor? (sim/não): ").strip().lower()
            if deseja in ("nao", "não"):
                print("Saque cancelado.")
                break
            elif deseja == "sim":
                if valor > saldo:
                    print("Saldo insuficiente.")
                else:
                    saldo -= valor
                    print(f"Saque realizado com sucesso. Seu saldo atual é de R${saldo}")
                break
            else:
                print("Nenhuma opção selecionada. Tente novamente.")
    elif opcao == "3":
        while True:
            valor = float(input("Digite o valor que deseja depositar: "))
            if valor <= 0:
                print("Valor inválido. Tente novamente.")
                continue
            deseja = input("Deseja mesmo depositar esse valor? (sim/não): ").strip().lower()
            if deseja in ("nao", "não"):
                print("Depósito cancelado.")
                break
            elif deseja == "sim":
                saldo += valor
                print(f"Depósito realizado com sucesso. Seu saldo atual é de R${saldo}")
                break
            else:
                print("Nenhuma opção selecionada. Tente novamente.")
    elif opcao == "4":
        print("Obrigado por usar nosso banco!")
        break
    elif opcao == "5":
        while True:
            nome_destinatario = input("Digite o nome do destinatario: ").strip()

            destinatario_obj = destinatario_bancario(nome_destinatario)
            if not destinatario_obj.verificar_destinatario():
                print("Dados do destinatário inválidos. Tente novamente.")
                continue

            if nome_destinatario.lower() not in [nome.lower() for nome, _ in usuarios]:
                print("Destinatário não encontrado. Tente novamente.")
                break

            valor = float(input("Digite o valor da transferência: "))
            if valor <= 0:
                print("Valor inválido. Tente novamente.")
                continue
            if valor > saldo:
                print("Saldo insuficiente para realizar a transferência.")
                break

            deseja = input(f"Deseja mesmo transferir R${valor:.2f} para {destinatario_obj.mostrar_detalhes()}? (sim/não): ").strip().lower()
            if deseja in ("nao", "não"):
                print("Transferência cancelada.")
                break
            elif deseja == "sim":
                saldo -= valor
                print(destinatario_obj.processar_transferencia(valor))
                print(f"Seu saldo atual é de R${saldo}")
                break
            else:
                print("Nenhuma opção selecionada. Tente novamente.")
    else:
        print("Opção inválida. Tente novamente.")

